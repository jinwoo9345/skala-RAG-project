# .env 파일에 설정하세요. 저장소에 인증키를 커밋하지 마세요.
OPENAI_API_KEY=
TAVILY_API_KEY=
# Responses API의 Structured Outputs 지원 모델
GENERATOR_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# 실험 재현 시 Hugging Face 모델 revision(commit)을 고정 권장
EMBEDDING_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
CHUNK_TOKENS=400
CHUNK_OVERLAP=50
DENSE_TOP_K=10
BM25_TOP_K=10
TOP_K=10
MAX_CONTEXT_CHUNKS=30
SEARCH_RESULTS=5
COUNTER_CLAIMS_PER_PERSPECTIVE=2
REQUEST_TIMEOUT=60
